# Default backend: local (Ollama) or codex (ChatGPT.app)
EXTRACTOR_BACKEND=local

# Local vision model (Ollama)
VLM_BASE_URL=http://localhost:11434/v1
VLM_API_KEY=EMPTY
VLM_MODEL=qwen2.5vl:7b
VLM_TIMEOUT_SECONDS=600
VLM_MAX_TOKENS=9000
VLM_TEMPERATURE=0.0
VLM_IMAGE_MAX_SIDE=1280
VLM_NUM_CTX=16384
VLM_MAX_RETRIES=3
LOCAL_PAGE_DELAY_SECONDS=2

# Codex (ChatGPT.app) — optional cloud backend
CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
CODEX_MODEL=

# PDF page render quality
RENDER_DPI=220
OUTPUT_DIR=./output

# PostgreSQL (shared schema with remote-lessons-gpt)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lessons_gpt

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=480
SUPER_ADMIN_EMAIL=superadmin@lessonsgpt.com
SUPER_ADMIN_PASSWORD=SuperAdmin123!
SUPER_ADMIN_NAME=Super Admin

# Local OpenSearch (admin UI searches here while developing locally)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX=school_book_content_v3
INDEX_TO_OPENSEARCH=true

# Remote production API (remote-lessons-gpt) — auth, catalog, and per-page ingest
# Example: https://api.example.com  or  http://localhost:8081
REMOTE_API_URL=

# Legacy direct OpenSearch sync (optional fallback if REMOTE_API_URL is empty)
REMOTE_OPENSEARCH_URL=
REMOTE_OPENSEARCH_USERNAME=
REMOTE_OPENSEARCH_PASSWORD=
REMOTE_OPENSEARCH_VERIFY_CERTS=true
REMOTE_OPENSEARCH_INDEX=school_book_content_v3

# REST API (compatible with admin-lessons-gpt on :5173)
API_HOST=0.0.0.0
API_PORT=8080
API_DATA_ROOT=./data
API_WORKER_COUNT=1
API_WORKER_POLL_SECONDS=0.5
API_MAX_UPLOAD_MB=1024
API_CORS_ORIGINS=*

# Rate-limit friendly pacing for Codex
CODEX_PAGE_DELAY_SECONDS=12
CODEX_MAX_RETRIES=12
CODEX_RETRY_BASE_SECONDS=30
CODEX_RETRY_MAX_SECONDS=600
