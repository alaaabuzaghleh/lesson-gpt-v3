# Copy to .env in this folder:  cp .env.example .env
#
# Local working directories (gitignored, not env vars):
#   ./books    drop PDFs for CLI ingest
#   ./output   MinerU/CLI extraction artifacts
# API uploads and job files still live under API_DATA_ROOT.

# --- Vision language model (Qwen via Ollama) ---
# Used only when VLM_PAGE_EXTRACTION_ENABLED=true.

# OpenAI-compatible VLM endpoint. Local Ollama is http://localhost:11434/v1
VLM_BASE_URL=http://localhost:11434/v1
# VLM URL for the API container in docker-compose (host.docker.internal reaches Ollama on the Mac)
DOCKER_VLM_BASE_URL=http://host.docker.internal:11434/v1
# API key for the VLM server. Ollama ignores this; keep EMPTY
VLM_API_KEY=EMPTY
# Ollama/Hugging Face model id used for page extraction and visual analysis
VLM_MODEL=qwen2.5vl:7b
# Seconds to wait for one VLM response before failing the page
VLM_TIMEOUT_SECONDS=600
# Maximum tokens the VLM may generate per page (higher = more complete JSON, slower)
VLM_MAX_TOKENS=9000
# Sampling temperature. 0.0 is deterministic and preferred for extraction
VLM_TEMPERATURE=0.0
# Longest image side in pixels sent to the VLM (larger = sharper, more VRAM/time)
VLM_IMAGE_MAX_SIDE=1280
# Ollama context window in tokens. Must be large enough for image + prompt + output
VLM_NUM_CTX=16384
# true = Qwen classifies every page after OCR (slow). false = index MinerU OCR only
VLM_PAGE_EXTRACTION_ENABLED=false

# --- PostgreSQL ---
# Catalog, users, and extraction jobs. Matches docker compose postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lessons_gpt

# --- Auth ---
# HMAC secret for JWT tokens. Change this in production
JWT_SECRET=change-me-in-production-use-long-random-string
# How long a login token stays valid, in minutes (480 = 8 hours)
JWT_EXPIRE_MINUTES=480
# Seeded super-admin login email (created on first API start if missing)
SUPER_ADMIN_EMAIL=superadmin@lessonsgpt.com
# Seeded super-admin password. Change after first login in production
SUPER_ADMIN_PASSWORD=SuperAdmin123!
# Display name stored for the seeded super-admin
SUPER_ADMIN_NAME=Super Admin

# --- OpenSearch ---
# Search cluster URL. Matches docker compose OpenSearch
OPENSEARCH_URL=http://localhost:9200
# Basic-auth user. Leave empty for the local unsigned cluster
OPENSEARCH_USERNAME=
# Basic-auth password. Leave empty for the local unsigned cluster
OPENSEARCH_PASSWORD=
# Verify TLS certificates. false for local http://localhost:9200
OPENSEARCH_VERIFY_CERTS=false
# Index name for extracted textbook blocks
OPENSEARCH_INDEX=school_book_content_v3

# --- MinerU document parser (https://github.com/opendatalab/mineru) ---
# Run mineru-api on :8000, or pip install "mineru[pipeline]" for in-process parse.

# true = parse pages with MinerU. false = use the PDF text layer only
MINERU_ENABLED=true
# true = fail the job if MinerU is down. false = fall back to PyMuPDF text
MINERU_REQUIRED=false
# mineru-api base URL. Empty = try the in-process Python API / CLI instead
MINERU_API_URL=http://127.0.0.1:8000
# OCR engine: pipeline (Arabic PaddleOCR, CPU/MPS) or hybrid-engine (GPU, needs mineru[all])
MINERU_BACKEND=pipeline
# How pages are read: auto (PDF text when possible), txt (embedded text only), ocr (OCR every page)
MINERU_PARSE_METHOD=ocr
# OCR language pack. arabic covers Arabic+English. Use ch for Chinese/English-only books
MINERU_LANGUAGE=arabic
# MinerU effort: low, medium, or high. high is slower and mainly helps hybrid-engine
MINERU_EFFORT=high
# Detect and emit LaTeX for formulas
MINERU_FORMULA_ENABLE=true
# Detect tables and emit HTML
MINERU_TABLE_ENABLE=true
# Analyze figures/charts instead of only storing placeholders
MINERU_IMAGE_ANALYSIS=true
# Seconds to wait for one MinerU parse (whole book or single page) before failing
MINERU_TIMEOUT_SECONDS=3600
# Seconds between polls while waiting for mineru-api to finish a job
MINERU_POLL_SECONDS=2
# Model download source. Empty = Hugging Face. Use modelscope if HF is blocked
MINERU_MODEL_SOURCE=
# Max characters of MinerU page text passed into the VLM prompt
MINERU_TEXT_CHARS=16000
# Pages with fewer than this many characters are marked sparse/empty
OCR_MIN_CHARS=20
# Re-run MinerU on pages that came back empty or too short
OCR_RETRY_EMPTY=true

# --- Rendering and visual pipeline ---
# DPI for page PNG renders (higher = sharper crops, larger files)
RENDER_DPI=220
# Extra pixels around a visual bbox when cropping an asset
VISUAL_CROP_PADDING_PX=12
# How many times to retry a failed VLM page extraction
MAX_RETRIES=3
# How many times to retry a failed visual-asset analysis
MAX_VISUAL_RETRIES=2
# Save full-page PNGs under the job output folder
SAVE_PAGE_IMAGES=true
# Save cropped visual assets (figures, charts, maps)
SAVE_VISUAL_CROPS=true
# Run the deep VLM pass on each cropped visual (only when VLM is enabled)
DEEP_VISUAL_ANALYSIS=true
# Second VLM pass to verify visual labels/summaries
VERIFY_VISUAL_ANALYSIS=true
# Include neighboring page text as context for visual analysis
INCLUDE_NEIGHBOR_PAGE_TEXT=true
# Max characters of surrounding page text sent with a visual crop
VISUAL_CONTEXT_CHARS=10000

# --- REST API ---
# Bind address. 0.0.0.0 allows the admin UI on another port to reach it
API_HOST=0.0.0.0
# Port for python run_api.py (admin Vite proxies here)
API_PORT=8080
# Root for uploaded PDFs, job artifacts, and catalog hero images
API_DATA_ROOT=./data
# Parallel extraction workers. 1 is safer on a laptop; 2+ needs more RAM
API_WORKER_COUNT=2
# Seconds a worker waits before polling Postgres for the next queued job
API_WORKER_POLL_SECONDS=0.5
# Reject uploads larger than this many megabytes
API_MAX_UPLOAD_MB=1024
# CORS allow-list. * is fine for local admin on localhost:5173
API_CORS_ORIGINS=*
