#!/usr/bin/env bash
# localLessonsGPT CLI — run infrastructure and apps from your machine
#
# Usage:
#   ./scripts/local up infra     Postgres, OpenSearch, Dashboards, pgAdmin
#   ./scripts/local up apps      remoteLessonsGPT API (Docker)
#   ./scripts/local up all       infra + apps
#   ./scripts/local down infra|apps|all
#   ./scripts/local status
#   ./scripts/local host         print host commands (extractor + admin)
#   ./scripts/local logs [infra|apps|SERVICE]

set -euo pipefail

LOCAL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
MONO_ROOT="$(cd "$LOCAL_DIR/.." && pwd)"
INFRA="$LOCAL_DIR/docker-compose.infra.yml"
APPS="$LOCAL_DIR/docker-compose.apps.yml"

ENV_FILE="$LOCAL_DIR/.env"
if [[ -f "$ENV_FILE" ]]; then
  COMPOSE_ENV=(--env-file "$ENV_FILE")
else
  COMPOSE_ENV=()
fi

dc_infra() { docker compose "${COMPOSE_ENV[@]}" -f "$INFRA" "$@"; }
dc_apps() { docker compose "${COMPOSE_ENV[@]}" -f "$APPS" "$@"; }

usage() {
  sed -n '3,12p' "$0" | sed 's/^# \?//'
  exit "${1:-0}"
}

cmd="${1:-}"
target="${2:-}"

case "$cmd" in
  up)
    case "$target" in
      infra)
        echo "Starting infrastructure (Postgres, OpenSearch, Dashboards, pgAdmin)..."
        dc_infra up -d
        echo ""
        echo "Infrastructure URLs:"
        echo "  Postgres:            localhost:5432  (postgres / postgres, db: lessons_gpt)"
        echo "  OpenSearch:          http://localhost:9200"
        echo "  OpenSearch Dashboards http://localhost:5601"
        echo "  pgAdmin:             http://localhost:5050  (admin@lessonsgpt.local / admin)"
        echo ""
        echo "In pgAdmin, add server: Host=postgres, Port=5432, User=postgres, Password=postgres"
        ;;
      apps)
        if ! docker network inspect lessons-gpt >/dev/null 2>&1; then
          echo "Network 'lessons-gpt' not found. Run: $0 up infra" >&2
          exit 1
        fi
        echo "Building and starting remoteLessonsGPT API..."
        dc_apps up -d --build
        echo ""
        echo "remoteLessonsGPT: http://localhost:${REMOTE_API_HOST_PORT:-8081}/docs"
        ;;
      all)
        "$0" up infra
        echo ""
        "$0" up apps
        echo ""
        "$0" host
        ;;
      *)
        echo "Usage: $0 up infra|apps|all" >&2
        exit 1
        ;;
    esac
    ;;
  down)
    case "$target" in
      infra)
        dc_infra down
        ;;
      apps)
        dc_apps down
        ;;
      all)
        dc_apps down || true
        dc_infra down
        ;;
      *)
        echo "Usage: $0 down infra|apps|all" >&2
        exit 1
        ;;
    esac
    ;;
  status)
    echo "=== Infrastructure ==="
    dc_infra ps || true
    echo ""
    echo "=== Applications ==="
    dc_apps ps || true
    ;;
  logs)
    shift || true
    if [[ "${1:-}" == "infra" ]]; then
      shift
      dc_infra logs -f "${@:-}"
    elif [[ "${1:-}" == "apps" ]]; then
      shift
      dc_apps logs -f "${@:-}"
    else
      dc_infra logs -f "${@:-}" &
      dc_apps logs -f "${@:-}" &
      wait
    fi
    ;;
  host)
    cat <<EOF

Run on your host (separate terminals):

  # extractorLessonsGPT — local PDF extraction (:8080)
  cd $MONO_ROOT/extractor-lessons-gpt
  cp -n .env.example .env   # set REMOTE_API_URL=http://localhost:8081
  source .venv/bin/activate 2>/dev/null || python3.13 -m venv .venv && source .venv/bin/activate
  pip install -U pip && pip install -r requirements.txt
  python run_api.py

  # adminLessonsGPT — UI (:5173)
  cd $MONO_ROOT/admin-lessons-gpt
  npm install && npm run dev

Login: http://localhost:5173/login
  Email:    superadmin@lessonsgpt.com
  Password: SuperAdmin123!

EOF
    ;;
  help|-h|--help|"")
    usage 0
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage 1
    ;;
esac
