# localLessonsGPT — copy to .env and adjust if needed

# Host port for remoteLessonsGPT API container (maps to internal 8080)
REMOTE_API_HOST_PORT=8081

# Shared index name
OPENSEARCH_INDEX=school_book_content_v3

# Remote API auth seed (first startup)
JWT_SECRET=change-me-in-production-use-long-random-string
SUPER_ADMIN_EMAIL=superadmin@lessonsgpt.com
SUPER_ADMIN_PASSWORD=SuperAdmin123!
SUPER_ADMIN_NAME=Super Admin

# --- Host apps (extractor + admin) use these on localhost ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lessons_gpt
OPENSEARCH_URL=http://localhost:9200
REMOTE_API_URL=http://localhost:8081

