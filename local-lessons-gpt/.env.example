# localLessonsGPT — Docker orchestration only (copy to .env)
#
# Remote API settings (auth, Postgres, OpenSearch, workers) live in:
#   ../remote-lessons-gpt/.env   ← cp ../remote-lessons-gpt/.env.example .env
#
# Host apps:
#   ../extractor-lessons-gpt/.env
#   ../admin-lessons-gpt/.env

# Host port published for the remoteLessonsGPT Docker container (internal :8080)
REMOTE_API_HOST_PORT=8081
